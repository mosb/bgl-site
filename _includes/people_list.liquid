{%- comment -%}
Compact list of people shown without cards: alumni and affiliates. Sorted by
surname here rather than in the data file, so the data files can stay in the
order people arrived and nobody has to re-sort them by hand. The surname is
taken as the last word of the name.

Parameters: heading (required), people (required), intro (optional sentence
shown under the heading). Each person has name, role, and optionally
affiliation, start, end and website.
{%- endcomment -%}
{%- assign keyed = "" -%}
{%- for a in include.people -%}
{%- assign surname = a.name | split: " " | last -%}
{%- assign keyed = keyed | append: surname | append: "~" | append: forloop.index0 | append: "," -%}
{%- endfor -%}
{%- assign pairs = keyed | split: "," | sort_natural -%}
<h2 class="bgl-member-group">{{ include.heading }}</h2>
{% if include.intro %}<p class="bgl-list-intro">{{ include.intro }}</p>{% endif %}
<ul class="bgl-alumni">
{%- for pair in pairs -%}
{%- assign bits = pair | split: "~" -%}
{%- assign idx = bits[1] | plus: 0 -%}
{%- assign a = include.people[idx] %}
  <li class="bgl-alumnus">
    {% if a.website %}
      <a class="bgl-alumnus-name" href="{{ a.website }}">{{ a.name }}</a>
    {% else %}
      <span class="bgl-alumnus-name">{{ a.name }}</span>
    {% endif %}
    <span class="bgl-alumnus-meta">
      {{ a.role }}{% if a.affiliation %}, {{ a.affiliation }}{% endif %}{% if a.start %}{% if a.end %}, {{ a.start }}–{{ a.end }}{% else %}, from {{ a.start }}{% endif %}{% endif %}
    </span>
  </li>
{%- endfor %}
</ul>
